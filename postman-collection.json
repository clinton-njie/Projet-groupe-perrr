{
  "info": {
    "name": "Projet Immo - Flux Escrow (mobile money)",
    "description": "Collection E2E : auth -> bien -> visite (escrow) -> reservation -> paiement -> notification.\nLes tokens et IDs sont enregistres automatiquement dans les variables de collection.\nLance les requetes DANS L'ORDRE (ou via Collection Runner).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "authUrl", "value": "http://localhost:8081" },
    { "key": "bienUrl", "value": "http://localhost:8084" },
    { "key": "visiteUrl", "value": "http://localhost:8085" },
    { "key": "reservationUrl", "value": "http://localhost:8086" },
    { "key": "paiementUrl", "value": "http://localhost:8088" },
    { "key": "notifUrl", "value": "http://localhost:8091" },
    { "key": "adminEmail", "value": "" },
    { "key": "clientEmail", "value": "" },
    { "key": "password", "value": "secret123" },
    { "key": "adminToken", "value": "" },
    { "key": "clientToken", "value": "" },
    { "key": "bienId", "value": "" },
    { "key": "visiteId", "value": "" },
    { "key": "visiteId2", "value": "" },
    { "key": "visiteId3", "value": "" },
    { "key": "reservationId", "value": "" }
  ],
  "item": [
    {
      "name": "0 - Auth & Setup",
      "item": [
        {
          "name": "Admin register (genere des emails uniques)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "var rid = Date.now();",
                "pm.collectionVariables.set('adminEmail', 'admin_' + rid + '@test.com');",
                "pm.collectionVariables.set('clientEmail', 'client_' + rid + '@test.com');"
              ], "type": "text/javascript" }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('admin cree (ou deja existant)', function () { pm.expect([200,201,400,409]).to.include(pm.response.code); });"
              ], "type": "text/javascript" }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\",\n  \"firstname\": \"Admin\",\n  \"lastname\": \"Boss\",\n  \"role\": \"ROLE_ADMIN\"\n}" },
            "url": { "raw": "{{authUrl}}/api/auth/admin/register", "host": ["{{authUrl}}"], "path": ["api","auth","admin","register"] }
          }
        },
        {
          "name": "Login admin (=> adminToken)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "var j = pm.response.json();",
              "pm.collectionVariables.set('adminToken', j.accessToken);",
              "pm.test('token admin recu', function () { pm.expect(j.accessToken).to.be.a('string'); });"
            ], "type": "text/javascript" }
          } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{authUrl}}/api/auth/login", "host": ["{{authUrl}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Client register (cree aussi le profil user)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "pm.test('client cree', function () { pm.expect([200,201,400,409]).to.include(pm.response.code); });"
            ], "type": "text/javascript" }
          } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"firstname\": \"Cli\",\n  \"lastname\": \"Ent\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{authUrl}}/api/auth/register", "host": ["{{authUrl}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Login client (=> clientToken)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "var j = pm.response.json();",
              "pm.collectionVariables.set('clientToken', j.accessToken);",
              "pm.test('token client recu', function () { pm.expect(j.accessToken).to.be.a('string'); });"
            ], "type": "text/javascript" }
          } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{authUrl}}/api/auth/login", "host": ["{{authUrl}}"], "path": ["api","auth","login"] }
          }
        }
      ]
    },
    {
      "name": "1 - Bien (token admin)",
      "item": [
        {
          "name": "Creer bien VILLA (=> bienId)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "pm.test('bien cree 201', function () { pm.response.to.have.status(201); });",
              "var j = pm.response.json();",
              "pm.collectionVariables.set('bienId', j.id);"
            ], "type": "text/javascript" }
          } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"categorie\": \"VILLA\",\n  \"nom\": \"Villa Postman\",\n  \"ville\": \"Douala\",\n  \"quartier\": \"Bonapriso\",\n  \"photoPrincipale\": \"photo.jpg\",\n  \"photosSecondaires\": [\"a.jpg\"],\n  \"prixMensuel\": 250000,\n  \"description\": \"Bien de test Postman\"\n}" },
            "url": { "raw": "{{bienUrl}}/api/biens", "host": ["{{bienUrl}}"], "path": ["api","biens"] }
          }
        },
        {
          "name": "Lister biens (public)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{bienUrl}}/api/biens", "host": ["{{bienUrl}}"], "path": ["api","biens"] } }
        },
        {
          "name": "Biens disponibles (public)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{bienUrl}}/api/biens/disponibles", "host": ["{{bienUrl}}"], "path": ["api","biens","disponibles"] } }
        },
        {
          "name": "Voir bien {{bienId}} (public)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{bienUrl}}/api/biens/{{bienId}}", "host": ["{{bienUrl}}"], "path": ["api","biens","{{bienId}}"] } }
        },
        {
          "name": "Prix visite VILLA (public)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{bienUrl}}/api/biens/categorie/VILLA/prix-visite", "host": ["{{bienUrl}}"], "path": ["api","biens","categorie","VILLA","prix-visite"] } }
        },
        {
          "name": "Update prix visite VILLA (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"prixVisite\": 12000\n}" },
            "url": { "raw": "{{bienUrl}}/api/biens/admin/prix-visite/VILLA", "host": ["{{bienUrl}}"], "path": ["api","biens","admin","prix-visite","VILLA"] }
          }
        }
      ]
    },
    {
      "name": "2 - Flux Visite (escrow)",
      "item": [
        {
          "name": "Creer visite A (=> visiteId) [escrow]",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "pm.test('visite creee 201', function () { pm.response.to.have.status(201); });",
              "var j = pm.response.json();",
              "pm.collectionVariables.set('visiteId', j.id);"
            ], "type": "text/javascript" }
          } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"bienId\": {{bienId}},\n  \"clientEmail\": \"{{clientEmail}}\",\n  \"dateHeureDebut\": \"2026-08-20T10:00:00\",\n  \"dateHeureFin\": \"2026-08-20T11:00:00\",\n  \"operateur\": \"ORANGE\",\n  \"telephone\": \"677000000\"\n}" },
            "url": { "raw": "{{visiteUrl}}/api/visites", "host": ["{{visiteUrl}}"], "path": ["api","visites"] }
          }
        },
        {
          "name": "Voir visite {{visiteId}} (attendu: PAYEE)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "var j = pm.response.json();",
              "pm.test('visite PAYEE (escrow OK)', function () { pm.expect(j.statut).to.eql('PAYEE'); });"
            ], "type": "text/javascript" }
          } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{visiteUrl}}/api/visites/{{visiteId}}", "host": ["{{visiteUrl}}"], "path": ["api","visites","{{visiteId}}"] } }
        },
        {
          "name": "Terminer visite {{visiteId}} (capture fonds -> agent)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "var j = pm.response.json();",
              "pm.test('visite TERMINE', function () { pm.expect(j.statut).to.eql('TERMINE'); });"
            ], "type": "text/javascript" }
          } ],
          "request": { "method": "PUT", "header": [], "url": { "raw": "{{visiteUrl}}/api/visites/{{visiteId}}/terminer", "host": ["{{visiteUrl}}"], "path": ["api","visites","{{visiteId}}","terminer"] } }
        },
        {
          "name": "Creer visite B (=> visiteId2)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "var j = pm.response.json();",
              "pm.collectionVariables.set('visiteId2', j.id);"
            ], "type": "text/javascript" }
          } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"bienId\": {{bienId}},\n  \"clientEmail\": \"{{clientEmail}}\",\n  \"dateHeureDebut\": \"2026-09-10T14:00:00\",\n  \"dateHeureFin\": \"2026-09-10T15:00:00\",\n  \"operateur\": \"MTN\",\n  \"telephone\": \"677000001\"\n}" },
            "url": { "raw": "{{visiteUrl}}/api/visites", "host": ["{{visiteUrl}}"], "path": ["api","visites"] }
          }
        },
        {
          "name": "Annuler visite {{visiteId2}} (client, >24h -> remboursement)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "var j = pm.response.json();",
              "pm.test('ANNULEE_CLIENT', function () { pm.expect(j.statut).to.eql('ANNULEE_CLIENT'); });"
            ], "type": "text/javascript" }
          } ],
          "request": { "method": "PUT", "header": [], "url": { "raw": "{{visiteUrl}}/api/visites/{{visiteId2}}/annuler", "host": ["{{visiteUrl}}"], "path": ["api","visites","{{visiteId2}}","annuler"] } }
        },
        {
          "name": "Creer visite C (=> visiteId3)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "var j = pm.response.json();",
              "pm.collectionVariables.set('visiteId3', j.id);"
            ], "type": "text/javascript" }
          } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"bienId\": {{bienId}},\n  \"clientEmail\": \"{{clientEmail}}\",\n  \"dateHeureDebut\": \"2026-09-15T09:00:00\",\n  \"dateHeureFin\": \"2026-09-15T10:00:00\",\n  \"operateur\": \"ORANGE\",\n  \"telephone\": \"677000002\"\n}" },
            "url": { "raw": "{{visiteUrl}}/api/visites", "host": ["{{visiteUrl}}"], "path": ["api","visites"] }
          }
        },
        {
          "name": "Annuler-agent visite {{visiteId3}} (-> ANNULEE_AGENT)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "var j = pm.response.json();",
              "pm.test('ANNULEE_AGENT (bug 3 corrige)', function () { pm.expect(j.statut).to.eql('ANNULEE_AGENT'); });"
            ], "type": "text/javascript" }
          } ],
          "request": { "method": "PUT", "header": [], "url": { "raw": "{{visiteUrl}}/api/visites/{{visiteId3}}/annuler-agent", "host": ["{{visiteUrl}}"], "path": ["api","visites","{{visiteId3}}","annuler-agent"] } }
        },
        {
          "name": "Visites du client",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{visiteUrl}}/api/visites/user/{{clientEmail}}", "host": ["{{visiteUrl}}"], "path": ["api","visites","user","{{clientEmail}}"] } }
        }
      ]
    },
    {
      "name": "3 - Flux Reservation (escrow direct)",
      "item": [
        {
          "name": "Creer reservation (=> reservationId) [token client]",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "pm.test('reservation creee', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "var j = pm.response.json();",
              "pm.collectionVariables.set('reservationId', j.id);"
            ], "type": "text/javascript" }
          } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{clientToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"propertyId\": {{bienId}},\n  \"startDate\": \"2026-08-01\",\n  \"endDate\": \"2026-10-01\",\n  \"operateur\": \"ORANGE\",\n  \"telephone\": \"690000000\"\n}" },
            "url": { "raw": "{{reservationUrl}}/api/reservations", "host": ["{{reservationUrl}}"], "path": ["api","reservations"] }
          }
        },
        {
          "name": "Voir reservation {{reservationId}} (attendu: CONFIRME)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "var j = pm.response.json();",
              "pm.test('reservation CONFIRME (paiement REUSSI)', function () { pm.expect(j.status).to.eql('CONFIRME'); });"
            ], "type": "text/javascript" }
          } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{clientToken}}" } ],
            "url": { "raw": "{{reservationUrl}}/api/reservations/{{reservationId}}", "host": ["{{reservationUrl}}"], "path": ["api","reservations","{{reservationId}}"] }
          }
        },
        {
          "name": "Bien {{bienId}} apres reservation (attendu: LOUE)",
          "event": [ {
            "listen": "test",
            "script": { "exec": [
              "var j = pm.response.json();",
              "pm.test('bien LOUE', function () { pm.expect(j.statut).to.eql('LOUE'); });"
            ], "type": "text/javascript" }
          } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{bienUrl}}/api/biens/{{bienId}}", "host": ["{{bienUrl}}"], "path": ["api","biens","{{bienId}}"] } }
        },
        {
          "name": "Annuler reservation {{reservationId}} (-> bien DISPONIBLE)",
          "request": { "method": "PUT", "header": [], "url": { "raw": "{{reservationUrl}}/api/reservations/{{reservationId}}/annuler", "host": ["{{reservationUrl}}"], "path": ["api","reservations","{{reservationId}}","annuler"] } }
        }
      ]
    },
    {
      "name": "4 - Notification (interne)",
      "item": [
        {
          "name": "Creer notification paiement",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nomUtilisateur\": \"Cli Ent\",\n  \"nomBien\": \"Villa Postman\",\n  \"natureType\": \"VISITE\",\n  \"statut\": \"SUCCESS\",\n  \"montant\": 12000\n}" },
            "url": { "raw": "{{notifUrl}}/api/notifications/paiement", "host": ["{{notifUrl}}"], "path": ["api","notifications","paiement"] }
          }
        }
      ]
    }
  ]
}
